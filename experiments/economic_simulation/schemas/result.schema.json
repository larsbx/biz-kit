  "$defs": {
    "scenario": {
      "title": "Synthetic economic scenario v1",
      "description": "Structural validation; runtime also checks references, IDs, exclusive barter lots and timestamp ordering.",
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "scenario_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
        },
        "description": {
          "type": "string",
          "maxLength": 4096,
          "default": ""
        },
        "start_at": {
