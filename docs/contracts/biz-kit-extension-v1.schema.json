{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/larsbx/biz-kit/blob/main/docs/contracts/biz-kit-extension-v1.schema.json",
  "title": "BizKit ExtensionV1 external manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "contract_version",
    "version",
    "dependencies",
    "capabilities",
    "requested_grants",
    "commands",
    "events",
    "projections",
    "migrations",
    "deployment",
    "activation",
    "health"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/id"
    },
    "contract_version": {
      "const": 1
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "min_version"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "min_version": {
            "$ref": "#/$defs/version"
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/qualified"
      },
      "uniqueItems": true
    },
    "requested_grants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/qualified"
      },
      "uniqueItems": true
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "writer",
          "required_grants"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/qualified"
          },
          "writer": {
            "$ref": "#/$defs/id"
          },
          "required_grants": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/qualified"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "writer"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/qualified"
          },
          "writer": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "projections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "source_event"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/qualified"
          },
          "source_event": {
            "$ref": "#/$defs/qualified"
          }
        }
      }
    },
    "migrations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/qualified"
      },
      "uniqueItems": true
    },
    "deployment": {
      "enum": [
        "integrated",
        "external"
      ]
    },
    "activation": {
      "const": "manual"
    },
    "health": {
      "const": "host"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "qualified": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    }
  },
  "description": "Shape is not authority. Host must also reject cross-domain writers, undeclared command grants, duplicate resources, missing/outdated extension dependencies and cycles. No runtime permission follows from registration."
}
