      "post": {
        "callbacks": {},
        "operationId": "DispatchWeb.MobileDeviceController.register",
        "parameters": [
          {
            "description": "",
            "in": "header",
            "name": "x-role-assignment-id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
