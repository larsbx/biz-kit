{
  "components": {
    "responses": {},
    "schemas": {
      "CapabilityDocumentResponse": {
        "additionalProperties": false,
        "properties": {
          "document": {
            "description": "base64url CoopEventCanonicalV1 (CBOR) claims: schema (DispatchCapabilityDocumentV1), schema_version, sub, tenant_id, participant_id, role_assignment_id, role, capabilities, features, status_options, iat, exp.",
            "type": "string"
          },
          "key_id": {
            "description": "`k-` and the signing key's first four bytes in hex.",
            "type": "string"
          },
          "signature": {
            "description": "base64url Ed25519 over the document bytes.",
            "type": "string"
          }
        },
        "required": [
          "document",
          "signature",
          "key_id"
        ],
        "title": "CapabilityDocumentResponse",
        "type": "object"
      },
      "CurrentStatus": {
        "additionalProperties": false,
        "properties": {
          "occurred_at": {
            "format": "date-time",
            "type": "string"
          },
          "role_key": {
            "type": "string"
          },
          "source": {
            "enum": [
              "PARTICIPANT"
            ],
            "type": "string"
          },
          "value": {
            "enum": [
              "AVAILABLE",
              "OFF_DUTY",
              "PRE_TRIP",
              "DEADHEAD",
              "EN_ROUTE_PICKUP",
              "AT_PICKUP",
              "LOADING",
              "EN_ROUTE_DELIVERY",
              "AT_DELIVERY",
              "UNLOADING",
              "DELAYED",
              "BREAKDOWN",
              "RESTING",
              "COMPLETE",
              "EMERGENCY"
            ],
            "type": "string"
          }
        },
        "required": [
          "value",
          "source",
          "role_key",
          "occurred_at"
        ],
        "title": "CurrentStatus",
        "type": "object"
      },
      "DependenciesResponse": {
        "additionalProperties": false,
        "properties": {
          "adapters": {
            "properties": {
              "ports": {
                "additionalProperties": true,
                "type": "object"
              },
              "required_secrets": {
                "additionalProperties": {
                  "type": "boolean"
                },
                "description": "Presence only; values are never reported.",
                "type": "object"
              }
            },
            "required": [
              "ports",
              "required_secrets"
            ],
            "type": "object"
          },
          "checked_at": {
            "format": "date-time",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "checked_at",
          "adapters"
        ],
        "title": "DependenciesResponse",
        "type": "object"
      },
      "DeviceRegistration": {
        "additionalProperties": false,
        "properties": {
          "device_id": {
            "format": "uuid",
            "type": "string"
          },
          "installation_id": {
            "type": "string"
          }
        },
        "required": [
          "device_id",
          "installation_id"
        ],
        "title": "DeviceRegistration",
        "type": "object"
      },
      "DeviceRegistrationRequest": {
        "additionalProperties": false,
        "properties": {
          "installation_id": {
            "description": "Stable per-installation identifier, chosen by the app.",
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "proof": {
            "description": "Base64url Ed25519 signature by that key over the CoopEventCanonicalV1 encoding of {schema: \"DispatchDeviceRegistrationV1\", tenant_id, participant_id, installation_id, public_key (bytes)}, the tenant and participant being the caller's.",
            "type": "string"
          },
          "public_key": {
            "description": "Base64url Ed25519 public key (32 bytes).",
            "type": "string"
          }
        },
        "required": [
          "installation_id",
          "public_key",
          "proof"
        ],
        "title": "DeviceRegistrationRequest",
        "type": "object"
      },
      "HealthCheck": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "Stable reason code when failing",
            "type": "string"
          },
          "pending": {
            "type": "integer"
          },
          "postgis_version": {
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "error"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthCheck",
        "type": "object"
      },
      "LivenessResponse": {
        "additionalProperties": false,
        "properties": {
          "checked_at": {
            "format": "date-time",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "checked_at"
        ],
        "title": "LivenessResponse",
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "Stable non-sensitive reason code",
            "type": "string"
          },
          "correlation_id": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "correlation_id"
        ],
        "title": "Problem",
        "type": "object"
      },
      "ReadinessResponse": {
        "additionalProperties": false,
        "properties": {
          "checked_at": {
            "format": "date-time",
            "type": "string"
          },
          "checks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/HealthCheck"
            },
            "type": "object"
          },
          "status": {
            "enum": [
              "ok",
              "unready"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "checked_at",
          "checks"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "RoleAssignmentChoice": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "label"
        ],
        "title": "RoleAssignmentChoice",
        "type": "object"
      },
      "RoleAssignmentList": {
        "additionalProperties": false,
        "properties": {
          "role_assignments": {
            "items": {
              "$ref": "#/components/schemas/RoleAssignmentChoice"
            },
            "type": "array"
          }
        },
        "required": [
          "role_assignments"
        ],
        "title": "RoleAssignmentList",
        "type": "object"
      },
      "StatusEvent": {
        "additionalProperties": false,
        "properties": {
          "assignment_id": {
            "format": "uuid",
            "nullable": true,
            "type": "string"
          },
          "device_id": {
            "format": "uuid",
            "nullable": true,
            "type": "string"
          },
          "device_sequence": {
            "nullable": true,
            "type": "integer"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "location_sample_id": {
            "format": "uuid",
            "nullable": true,
            "type": "string"
          },
          "note": {
            "nullable": true,
            "type": "string"
          },
          "occurred_at": {
            "format": "date-time",
            "type": "string"
          },
          "participant_id": {
            "format": "uuid",
            "type": "string"
          },
          "recorded_at": {
            "description": "When the server stored it; distinct from occurred_at for offline events.",
            "format": "date-time",
            "type": "string"
          },
          "role_assignment_id": {
            "format": "uuid",
            "type": "string"
          },
          "source": {
            "description": "Section 5.2: a status is a declaration, so this is always PARTICIPANT.",
            "enum": [
              "PARTICIPANT"
            ],
            "type": "string"
          },
          "status": {
            "enum": [
              "AVAILABLE",
              "OFF_DUTY",
              "PRE_TRIP",
              "DEADHEAD",
              "EN_ROUTE_PICKUP",
              "AT_PICKUP",
              "LOADING",
              "EN_ROUTE_DELIVERY",
              "AT_DELIVERY",
              "UNLOADING",
              "DELAYED",
              "BREAKDOWN",
              "RESTING",
              "COMPLETE",
              "EMERGENCY"
            ],
            "type": "string"
          },
          "supersedes_event_id": {
            "format": "uuid",
            "nullable": true,
            "type": "string"
          },
          "verification": {
            "enum": [
              "NONE",
              "DEVICE_AUTHENTICATED",
              "SYSTEM_BIOMETRIC",
              "FACE_1_TO_1"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "participant_id",
          "role_assignment_id",
          "status",
          "source",
          "occurred_at",
          "recorded_at",
          "verification"
        ],
        "title": "StatusEvent",
        "type": "object"
      },
      "StatusEventRequest": {
        "additionalProperties": false,
        "properties": {
          "assignment_id": {
            "format": "uuid",
            "type": "string"
          },
          "device_id": {
            "format": "uuid",
            "type": "string"
          },
          "device_sequence": {
            "minimum": 0,
            "type": "integer"
          },
          "device_signature": {
            "description": "Base64url Ed25519 signature by the registered device's key over the CoopEventCanonicalV1 encoding of this body's other fields plus \"schema\": \"DispatchStatusEventV1\". Required when device_id names the caller's active device; the event is then DEVICE_AUTHENTICATED.",
            "type": "string"
          },
          "event_id": {
            "description": "Client-assigned UUIDv7. Becomes the stored event's ID, so an offline client can reconcile by the identifier it recorded before uploading. Omitted, the server assigns one. Already in use: 409 EVENT_ID_CONFLICT.",
            "format": "uuid",
            "type": "string"
          },
          "location_sample_id": {
            "format": "uuid",
            "type": "string"
          },
          "note": {
            "description": "Required and nonblank for DELAYED and BREAKDOWN.",
            "maxLength": 1000,
            "type": "string"
          },
          "occurred_at": {
            "description": "RFC 3339 UTC. May not exceed server time by more than five minutes.",
            "format": "date-time",
            "type": "string"
          },
          "status": {
            "enum": [
              "AVAILABLE",
              "OFF_DUTY",
              "PRE_TRIP",
              "DEADHEAD",
              "EN_ROUTE_PICKUP",
              "AT_PICKUP",
              "LOADING",
              "EN_ROUTE_DELIVERY",
              "AT_DELIVERY",
              "UNLOADING",
              "DELAYED",
              "BREAKDOWN",
              "RESTING",
              "COMPLETE",
              "EMERGENCY"
            ],
            "type": "string"
          },
          "supersedes_event_id": {
            "description": "The event this corrects. History is appended, never rewritten.",
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "status",
          "occurred_at"
        ],
        "title": "StatusEventRequest",
        "type": "object"
      },
      "StatusEventResponse": {
        "additionalProperties": false,
        "properties": {
          "current_status": {
            "$ref": "#/components/schemas/CurrentStatus"
          },
          "event": {
            "$ref": "#/components/schemas/StatusEvent"
          }
        },
        "required": [
          "event",
          "current_status"
        ],
        "title": "StatusEventResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Machine API for the field application and internal services.\n\nPortal endpoints under `/ui` return HTML or Datastar SSE and are not\ndescribed here; Section 24.5 keeps them separate from the `/v1` machine\nAPI on purpose.\n",
    "title": "Dispatch Platform API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/dependencies": {
      "get": {
        "callbacks": {},
        "description": "Redacted adapter selection and secret presence. Never reports secret values.",
        "operationId": "DispatchWeb.HealthController.dependencies",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DependenciesResponse"
                }
              }
            },
            "description": "Configuration"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Adapter configuration",
        "tags": [
          "health"
        ]
      }
    },
    "/health/live": {
      "get": {
        "callbacks": {},
        "description": "Reports that the process is running. Asserts nothing about dependencies.",
        "operationId": "DispatchWeb.HealthController.live",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            },
            "description": "Liveness"
          }
        },
        "summary": "Process liveness",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "callbacks": {},
        "description": "Database reachability and migration state. Makes no outbound provider call.",
        "operationId": "DispatchWeb.HealthController.ready",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Ready"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Not ready"
          }
        },
        "summary": "Readiness",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/driver/status-events": {
      "post": {
        "callbacks": {},
        "description": "Section 24.1's DRIVER compatibility route. Identical behaviour to /v1/me.",
        "operationId": "DispatchWeb.StatusEventController.create_driver",
        "parameters": [
          {
            "description": "Replaying a mutation with the same key returns the stored response.",
            "in": "header",
            "name": "idempotency-key",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Selects which held role assignment the request acts under. It selects authority context; it never grants it.",
            "in": "header",
            "name": "x-role-assignment-id",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StatusEventRequest"
              }
            }
          },
          "description": "Declaration",
          "required": false
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusEventResponse"
                }
              }
            },
            "description": "Stored declaration"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Malformed request"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthenticated"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not permitted"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Conflicting reuse"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Validation failed"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Declare a driver status (compatibility projection)",
        "tags": [
          "status"
        ]
      }
    },
    "/v1/me/devices": {
      "post": {
        "callbacks": {},
        "description": "Self-service: the proof shows the caller's installation holds the key, and\nno one approves it. Registering the same key again returns the device. An\ninstallation registered with another key, or to someone else, is a\nconflict; a new installation is how a key changes.\n",
        "operationId": "DispatchWeb.DeviceController.create",
        "parameters": [
          {
            "description": "Replaying a mutation with the same key returns the stored response.",
            "in": "header",
            "name": "idempotency-key",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Selects which held role assignment the request acts under, when there are several. The device is the participant's, whichever is selected.",
            "in": "header",
            "name": "x-role-assignment-id",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceRegistrationRequest"
              }
            }
          },
          "description": "Registration",
          "required": false
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceRegistration"
                }
              }
            },
            "description": "Already registered"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceRegistration"
                }
              }
            },
            "description": "Registered"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Register this installation's device key",
        "tags": [
          "devices"
        ]
      }
    },
    "/v1/me/role-assignments": {
      "get": {
        "callbacks": {},
        "description": "Identifiers and labels only. Choose one and send it as\n`X-Role-Assignment-ID`; the choice selects authority context, it never\ngrants it.\n",
        "operationId": "DispatchWeb.RoleCapabilityController.assignments",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoleAssignmentList"
                }
              }
            },
            "description": "Selectable assignments"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "List the role assignments this principal may act under",
        "tags": [
          "roles"
        ]
      }
    },
    "/v1/me/status-events": {
      "post": {
        "callbacks": {},
        "description": "Records a self-declared status for the authenticated participant. The\nparticipant is derived from the token and the active role assignment; it is\nnot a parameter.\n",
        "operationId": "DispatchWeb.StatusEventController.create",
        "parameters": [
          {
            "description": "Replaying a mutation with the same key returns the stored response.",
            "in": "header",
            "name": "idempotency-key",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Selects which held role assignment the request acts under. It selects authority context; it never grants it.",
            "in": "header",
            "name": "x-role-assignment-id",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StatusEventRequest"
              }
            }
          },
          "description": "Declaration",
          "required": false
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusEventResponse"
                }
              }
            },
            "description": "Stored declaration"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Malformed request"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthenticated"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not permitted"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Conflicting reuse"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Validation failed"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Declare a participant status",
        "tags": [
          "status"
        ]
      }
    },
    "/v1/role-capabilities": {
      "get": {
        "callbacks": {},
        "description": "Features are enabled from this document, never from a role key. It governs\nwhat the client offers; every request is still authorized by the server.\n",
        "operationId": "DispatchWeb.RoleCapabilityController.capabilities",
        "parameters": [
          {
            "description": "Selects which held role assignment the document describes.",
            "in": "header",
            "name": "x-role-assignment-id",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilityDocumentResponse"
                }
              }
            },
            "description": "Signed document"
